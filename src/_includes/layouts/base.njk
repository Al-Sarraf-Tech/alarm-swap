<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<meta name="theme-color" content="#b42318">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='%23fff' stroke='%23b42318' stroke-width='2'/%3E%3Ccircle cx='8' cy='8' r='2' fill='%23b42318'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/"><span class="dot" aria-hidden="true"></span>{{ site.name }}</a>
    <nav aria-label="Main">
      <a href="/models/">Models</a>
      <a href="/guides/">Guides</a>
      <a href="/about/">Sources</a>
    </nav>
  </div>
</header>
<main id="main" class="wrap" {% if pagefindIgnore %}{% else %}data-pagefind-body{% endif %}>
{{ content | safe }}
</main>
<footer class="foot">
  <div class="wrap">
    <p class="safety"><strong>If an alarm is sounding its full alarm, get out, call 911 and stay out</strong> (<a href="https://www.nfpa.org/education-and-research/home-fire-safety/smoke-alarms" rel="nofollow noopener">NFPA</a>). This site is for planning a replacement, not for emergencies.</p>
    <p>{{ site.name }} restates what alarm makers, NFPA, USFA and CPSC publish, with a link and a "checked" date on every fact. It is not affiliated with any brand. <a href="/about/">How we source</a> · <a href="/disclosure/">Disclosure</a></p>
  </div>
</footer>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "df3a3255aa02445e8729ecf3fed5b56a"}'></script>
</body>
</html>
