---
layout: layouts/base.njk
title: "Smoke and CO alarm models"
description: "Every smoke and CO alarm model AlarmSwap covers, grouped by brand, with links to its age, expiry and replacement page."
permalink: /models/
ogImage: /og/models.svg
crumbs:
  - name: Home
    url: "/"
  - name: Models
---
<h1>Smoke and CO alarm models</h1>
<p class="lede">One page per model. New pages are added regularly.</p>
{%- for hub in brandHubs %}
  {%- set brandModels = models | modelsForHub(hub) -%}
  {% if brandModels.length %}
  <h2><a href="/brands/{{ hub.slug }}/">{{ hub.name }}</a></h2>
  <ul class="cards">
  {%- for m in brandModels %}
    <li><a href="/models/{{ m.slug }}/"><strong>{{ m.brand }} {{ m.model }}</strong> <span>{{ m.kind }}{% if m.aliases and m.aliases.length %} · also {{ m.aliases | join(", ") }}{% endif %}</span></a></li>
  {%- endfor %}
  </ul>
  {% endif %}
{%- endfor %}
