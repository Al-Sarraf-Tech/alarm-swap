---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.url.endsWith(".html") %}
  <url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p | pageLastmod(models, guides) }}</lastmod></url>
{%- endif %}{% endfor %}
  <url><loc>{{ site.url }}/llms.txt</loc><lastmod>{{ models | contentLastmod(guides) }}</lastmod></url>
  <url><loc>{{ site.url }}/llms-full.txt</loc><lastmod>{{ models | contentLastmod(guides) }}</lastmod></url>
</urlset>
